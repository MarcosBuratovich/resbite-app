              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.resbite.preview",
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/resbite-mark.png",
          "imageWidth": 120,
          "backgroundColor": "#FAF5F0"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile or for a resbite’s cover.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Choose contacts to invite. Resbite checks only the numbers you pick to see who already uses it."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Resbite doesn’t read your calendar. It only opens iPhone’s own form so you can add an event you choose.",
          "remindersPermission": "Resbite doesn’t use your reminders. The calendar library it relies on requires this description."
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "67671c20-374c-470e-995d-a4ec8ad5b852"
      }
    },
    "owner": "marcosburato"
  }
}

{
  "expo": {
    "name": "Resbite",
    "slug": "resbite",
    "scheme": "resbite",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.resbite.preview"
    },
    "android": {
      "package": "com.resbite.preview"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/resbite-mark.png",
          "imageWidth": 120,
          "backgroundColor": "#FAF5F0"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location when choosing where to meet."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Choose contacts to invite to your Resbite plans."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

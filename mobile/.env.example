EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Keep disabled until local/hosted lifecycle acceptance and retention setup pass.
EXPO_PUBLIC_ACCOUNT_DELETION_ENABLED=false
# Plan 4: "true" registers this phone for push and lets Notification settings say so. Unset means off;
# keep it off until the owner's release steps (credentials, sender switch) are done.
EXPO_PUBLIC_PUSH_ENABLED=false
# Optional owned HTTPS origin; leave unset until associated-domain hosting is configured.
# EXPO_PUBLIC_INVITATION_ORIGIN=https://your-owned-domain.example

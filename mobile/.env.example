EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Keep disabled until local/hosted lifecycle acceptance and retention setup pass.
EXPO_PUBLIC_ACCOUNT_DELETION_ENABLED=false
# Plan 4: "true" registers this phone for push and lets Notification settings say so. Unset means off;
# keep it off until the owner's release steps (credentials, sender switch) are done.
EXPO_PUBLIC_PUSH_ENABLED=false
# Optional owned HTTPS origin; leave unset until associated-domain hosting is configured.
# EXPO_PUBLIC_INVITATION_ORIGIN=https://your-owned-domain.example
# Chat plan 3: the support address Data & privacy's Contact topic and a report's thanks show (an email address).
# Unset, or not an address, the app shows no contact line. Set it in the EAS production environment before the build
# (qa/chat-release/README.md, step 5b); App Store submission waits for it.
# EXPO_PUBLIC_SUPPORT_ADDRESS=
# App Store readiness plan 3: the Terms of Use and Privacy Policy links. Optional: unset, the app uses
# https://link.resbite.com/terms and https://link.resbite.com/privacy. Set one only if the pages move; an https link only.
# EXPO_PUBLIC_TERMS_URL=
# EXPO_PUBLIC_PRIVACY_URL=
